# Backend configuration
PORT=5000

# MongoDB Atlas M0 (Free 512 MB)
# Replace USERNAME, PASSWORD and CLUSTER with your Atlas values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/branded_shortlink?retryWrites=true&w=majority

CLIENT_URL=http://localhost:5173

# Generate long random values for these secrets.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Local development: false. Production over HTTPS: true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
